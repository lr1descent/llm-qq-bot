OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:3000/v1
# onebot: ordinary QQ account via NapCat; official: QQ Open Platform bot.
QQ_TRANSPORT=onebot
ONEBOT_API_URL=http://127.0.0.1:3001
ONEBOT_API_TOKEN=
ONEBOT_EVENT_SECRET=
# Only needed for QQ_TRANSPORT=official:
QQ_APP_ID=
QQ_APP_SECRET=
# Full group message mode needs the bot's OpenID from the QQ mentions payload.
QQ_BOT_ID=
# Use an absolute path when deploying outside the project directory.
DATABASE_PATH=data/bot.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal
# Set true behind HTTPS. Keep false for local http://127.0.0.1 development.
SECURE_COOKIE=false
